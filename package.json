{
  "name": "asshrabha-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate:create": "prisma migrate dev --name init --create-only --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:seed": "node prisma/seed-pg.js",
    "db:ensure-schema": "node scripts/ensure-schema.js",
    "db:seed-test": "node scripts/seed-test-user.js",
    "startup": "npx prisma generate --schema=prisma/schema.prisma && node scripts/ensure-schema.js && node scripts/seed-test-user.js && npm run dev"
  },
  "playwright": {
    "testDir": "tests/e2e"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "latest",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.13.0",
    "pg": "^8.11.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.79.0",
    "recharts": "^3.8.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "latest",
    "typescript": "^5",
    "vitest": "^1.2.0"
  }
}
