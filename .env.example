# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/asshrabha?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Asshrabha"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"
# Optional: set a public URL to a bell/mp3/wav file for incoming notification sound.
NEXT_PUBLIC_NOTIFICATION_SOUND_URL="https://files.marymatelier.com/browser/ashrabha/freesound_community-bell-98033.mp3"

# Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="5"

# WhatsApp OTP provider (WhatsApp Cloud / Meta)
WHATSAPP_PROVIDER=meta

# Meta (WhatsApp Cloud) credentials
WHATSAPP_META_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=OTP_CONFIRM

# Note: Do NOT commit real secrets. Use environment variables in deployment.
